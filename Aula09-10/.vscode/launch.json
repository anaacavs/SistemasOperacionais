{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Bucket Sort sequencial",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bucket_sort",
            "args": ["entradas/pequena.txt"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Compilar bucket_sort"
        },
